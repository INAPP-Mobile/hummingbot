# ==============================================================================
# HUMMINGBOT RUN MODE (headless by default — the image's native env vars)
# ==============================================================================

PORT=8080

# Headless mode: no interactive TUI; strategy loads from SCRIPT_CONFIG.
# Keep true for Railway (there is no TTY on a hosted container).
HEADLESS_MODE=true

# Strategy config file to run (from conf/scripts/ on the volume).
SCRIPT_CONFIG=simple_pmm.yml

# ==============================================================================
# STRATEGY PARAMETERS (applied to the seeded simple_pmm.yml on every boot)
# ==============================================================================

# Connector id — paper_trade variants need no API keys.
# kraken_paper_trade works worldwide; binance_paper_trade is geo-blocked on some hosts.
HBOT_EXCHANGE=kraken_paper_trade

# Market to make, e.g. ETH-USD, BTC-USDT
HBOT_TRADING_PAIR=ETH-USD

# Order size in base currency
HBOT_ORDER_AMOUNT=0.05

# Bid/ask spread from mid price, in percent (0.5 = 0.5%)
HBOT_BID_SPREAD=0.5
HBOT_ASK_SPREAD=0.5

# Seconds between order refreshes
HBOT_ORDER_REFRESH_TIME=30

# mid | last | best_bid | best_ask
HBOT_PRICE_TYPE=mid

# Emergency stop: enable + max drawdown percent (e.g. -5.0)
HBOT_KILL_SWITCH_ENABLED=false
HBOT_KILL_SWITCH_RATE=-10.0

# ==============================================================================
# SECURITY / CREDENTIALS
# ==============================================================================

# Keystore password — encrypts connector API keys stored on the volume.
# The Railway template auto-generates one per deployment; set your own to keep
# keys readable across rebuilds (losing it means re-entering API keys).
CONFIG_PASSWORD=change-me-keystore-password

# Live trading only (paper trading needs none). Hummingbot stores connector
# API keys in its encrypted keystore — add them from inside the container:
#   railway run --service hummingbot -- hbot connect kraken
#   railway run --service hummingbot -- hbot balance --json